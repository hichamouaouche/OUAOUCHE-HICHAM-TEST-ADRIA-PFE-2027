{
  "realm": "bank",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "ADMIN" },
      { "name": "INTERNAL" },
      { "name": "MCP_CLIENT" }
    ]
  },
  "clients": [
    {
      "clientId": "bank-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "transaction-service",
      "secret": "transaction-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "assistant-service",
      "secret": "assistant-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "user1",
      "email": "user1@bank.local",
      "firstName": "Demo",
      "lastName": "User",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "user1", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin1",
      "email": "admin1@bank.local",
      "firstName": "Demo",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin1", "temporary": false }],
      "realmRoles": ["USER", "ADMIN"]
    },
    {
      "username": "service-account-transaction-service",
      "enabled": true,
      "serviceAccountClientId": "transaction-service",
      "realmRoles": ["INTERNAL"]
    },
    {
      "username": "service-account-assistant-service",
      "enabled": true,
      "serviceAccountClientId": "assistant-service",
      "realmRoles": ["MCP_CLIENT"]
    }
  ]
}
