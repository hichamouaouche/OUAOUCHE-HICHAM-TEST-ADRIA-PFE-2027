type Query {
    accounts: [Account!]!
    account(id: ID!): Account
}

type Mutation {
    createAccount(input: CreateAccountInput!): Account!
    changeAccountStatus(id: ID!, status: AccountStatus!): Account!
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}

input CreateAccountInput {
    customerReference: String!
    currency: String!
    initialBalance: Float!
}
